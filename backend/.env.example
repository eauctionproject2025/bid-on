DATABASE_URL="postgresql://postgres:12345678@localhost:5432/bidon?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
FRONTEND_URL="http://localhost:3000"
# Preferred on blocked networks (HTTPS) — https://resend.com/api-keys
# Free test: from must be onboarding@resend.dev and "to" must be your Resend account email
RESEND_API_KEY=""
RESEND_FROM="Bid On <onboarding@resend.dev>"
# Optional Gmail SMTP (often blocked by ISP) — leave empty if using Resend
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Bid On <noreply@bidon.local>"
# Stripe test / sandbox — leave empty to simulate payments locally
STRIPE_SECRET_KEY="sk_test_... or rkcs_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Use usd for Stripe sandboxes; set bdt when enabled on your account
STRIPE_CURRENCY="usd"
UPLOAD_DIR="uploads"

# --- Production (Render) ---
# Defined in render.yaml at the repo root. Do not commit real secrets.
# NODE_ENV=production
# PORT is injected by Render
# FRONTEND_URL=https://your-app.vercel.app
# DATABASE_URL comes from the bid-on-db Postgres instance (internal URL)
# UPLOAD_DIR=uploads   # ephemeral on the free web service
# Pair with Vercel: NEXT_PUBLIC_API_URL=https://bid-on-api.onrender.com
